{
    "name": "dataforge-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"../test-data/*.{ts,mjs}\" package.json tsconfig.json",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"../test-data/*.{ts,mjs}\" package.json tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test test/**/*.test.ts",
        "test:smoke": "node scripts/smoke-test.mjs"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "multer": "^2.0.2"
    },
    "devDependencies": {
        "@types/archiver": "^6.0.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.3.0",
        "prettier": "^3.6.2",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=20"
    }
}
